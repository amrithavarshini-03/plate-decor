# BRB Decors — Backend Environment Variables
APP_NAME="BRB Decors API"
ENVIRONMENT="development"
DEBUG=true

# Database: SQLite for effortless local dev, PostgreSQL for production
DATABASE_URL="sqlite:///./brb_decors.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brb_decors"

# Security & Admin Authentication
SECRET_KEY="brb_decors_super_secret_jwt_key_chennai_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_INITIAL_EMAIL="admin@brbdecors.com"
ADMIN_INITIAL_PASSWORD="AdminDecors@2026"

# Feature Flags
ENABLE_PAYMENTS=false
ENABLE_WHATSAPP_CLOUD=false
ENABLE_RESEND_EMAIL=false

# Third-party Integrations (Optional)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="bookings@brbdecors.com"
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
CLOUDINARY_URL=""

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
